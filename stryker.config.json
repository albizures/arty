{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/**/!(*.test|*.spec).{ts,tsx}"
  ],
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner",
		"@stryker-mutator/typescript-checker",
		"./test/plugins/stryker-assert-message-ignorer.mjs"
  ],
  "ignorers": [
    "assert-messages"
  ],
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
	"ignorePatterns": [".pnpm-store", ".scratch", "coverage"],
	"thresholds": {
		"high": 100,
		"low": 100,
		"break": 100
	},
	"ignoreStatic": true,
	"incremental": true,
	"htmlReporter": {
		"fileName": "reports/mutation/mutation.html"
	},
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "coverageAnalysis": "perTest",
  "packageManager": "pnpm",
  "allowEmpty": true
}
